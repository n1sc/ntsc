# Maintainer: yasakei
# Source-based package for Arch Linux / the AUR. Builds the compiler with
# cargo against the system LLVM and installs the binary plus a man page.

pkgname=ntsc
pkgver=26.0.0b
pkgrel=1
pkgdesc="Neutron Type-Safe Compiler: a statically typed, memory-safe systems language compiled through LLVM"
arch=('x86_64' 'aarch64')
url="https://github.com/yasakei/neutron-rs"
license=('custom:NPL-1.1')
depends=('llvm-libs')
makedepends=('cargo' 'rust' 'llvm')
source=("$pkgname-$pkgver.tar.gz::https://github.com/yasakei/neutron-rs/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/neutron-rs-$pkgver"
  # ntsc-cli does not depend on ntsc-runtime, so the static archive `ntsc
  # build` links against is not produced as a side effect — build it too.
  cargo build --release -p ntsc-cli -p ntsc-lsp -p ntsc-runtime
  (cd crates/ntsc-pkg && ../../target/release/ntsc build --release)
}

package() {
  cd "$srcdir/neutron-rs-$pkgver"
  install -Dm755 target/release/ntsc "$pkgdir/usr/bin/ntsc"
  install -Dm755 crates/ntsc-pkg/build/release/ntsc-pkg "$pkgdir/usr/bin/ntsc-pkg"
  install -Dm755 target/release/ntsc-lsp "$pkgdir/usr/bin/ntsc-lsp"
  # The runtime archive an installed `ntsc build` links every NTSC program
  # against. Resolved at runtime via the executable-relative <prefix>/lib/ntsc.
  install -Dm644 target/release/libntsc_runtime.a "$pkgdir/usr/lib/ntsc/libntsc_runtime.a"
  install -Dm644 .github/packaging/ntsc.1 "$pkgdir/usr/share/man/man1/ntsc.1"
  gzip -9 "$pkgdir/usr/share/man/man1/ntsc.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
