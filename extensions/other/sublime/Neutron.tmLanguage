<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>nt</string>
	</array>
	<key>name</key>
	<string>Neutron</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>match</key>
			<string>#.*$</string>
			<key>name</key>
			<string>comment.line.number-sign.neutron</string>
		</dict>
		<dict>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>name</key>
			<string>string.quoted.double.neutron</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\\.</string>
					<key>name</key>
					<string>constant.character.escape.neutron</string>
				</dict>
				<dict>
					<key>begin</key>
					<string>\$\{</string>
					<key>end</key>
					<string>\}</string>
					<key>name</key>
					<string>meta.interpolation.neutron</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>$self</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:and|as|async|await|break|case|catch|chan|class|close|continue|copy|default|defer|do|elif|else|enum|extern|finally|for|from|fun|go|if|impl|in|match|mut|or|own|private|quiet|retry|return|say|shared|static|test|throw|trait|try|type|unsafe|use|var|view|while)\b</string>
			<key>name</key>
			<string>keyword.control.neutron</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:int|float|string|bool|array|object|option|result|any|pointer|slice)\b</string>
			<key>name</key>
			<string>storage.type.neutron</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:true|false|nil|this|super)\b</string>
			<key>name</key>
			<string>constant.language.neutron</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b[A-Za-z_][A-Za-z_0-9]*(?=\s*\()</string>
			<key>name</key>
			<string>entity.name.function.neutron</string>
		</dict>
		<dict>
			<key>match</key>
			<string>@[A-Za-z_][A-Za-z_0-9]*</string>
			<key>name</key>
			<string>entity.name.namespace.neutron</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*(?:\.[\d_]+)?(?:[eE][+-]?[\d_]+)?)\b</string>
			<key>name</key>
			<string>constant.numeric.neutron</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>source.neutron</string>
</dict>
</plist>
