use "modules/install" as installer
use "modules/registry" as registry

use sys
use strings
use arrays

fun main() -> int {
    var args = sys.args()
    var command = ""
    var first = ""

    if (arrays.length(args) >= 2) {
        command = arrays.get(args, 1)
    }
    if (arrays.length(args) >= 3) {
        first = arrays.get(args, 2)
    }

    match (command) {
        case "install" => {
            if (strings.is_empty(first)) {
                return report(installer.install(sys.cwd()))
            }
            return report(installer.add(sys.cwd(), first))
        }
        case "remove" => {
            if (strings.is_empty(first)) {
                say("usage: ntsc pkg remove <name>")
                return 1
            }
            return report(installer.remove(sys.cwd(), first))
        }
        case "update" => return report(installer.update(sys.cwd()))
        case "list" => return report(installer.list_installed(sys.cwd()))
        case "search" => return search(first)
        case "help" => {
            usage()
            return 0
        }
        case "--help" => {
            usage()
            return 0
        }
        case "-h" => {
            usage()
            return 0
        }
        case "" => {
            usage()
            return 0
        }
        default => {
            say("error: unknown command '" + copy(command) + "'")
            say("")
            usage()
            return 1
        }
    }
}

fun report(result[bool, string] outcome) -> int {
    match (outcome) {
        case Ok(_) => return 0
        case Err(e) => {
            say("error: " + e)
            return 1
        }
    }
}

fun search(view string query) -> int {
    if (strings.is_empty(query)) {
        say("usage: ntsc pkg search <query>")
        return 1
    }

    var result[array[string], string] found = registry.search(query)
    match (found) {
        case Err(e) => {
            say("error: " + e)
            return 1
        }
        case Ok(entries) => {
            var count = arrays.length(entries)
            if (count == 0) {
                say("no packages matching '" + copy(query) + "'")
                return 0
            }
            for (var i = 0; i < count; i = i + 1) {
                var entry = arrays.get(entries, i)
                var version = registry.latest_version(entry)
                var label = registry.package_name(entry)
                if (!strings.is_empty(version)) {
                    label = label + " " + version
                }
                say("  " + label)
                var description = registry.package_description(entry)
                if (!strings.is_empty(description)) {
                    say("    " + description)
                }
            }
            return 0
        }
    }
}

fun usage() {
    say("ntsc pkg - Neutron package manager")
    say("")
    say("commands:")
    say("  install                install the dependencies in neutron.toml")
    say("  install <name>         add a package at its latest version")
    say("  install <name>@<req>   add a package with an explicit requirement")
    say("  remove <name>          drop a dependency and unvendor it")
    say("  update                 re-resolve to the newest allowed versions")
    say("  list                   list the packages in neutron.lock")
    say("  search <query>         search the registry")
    say("  help                   show this help")
    say("")
    say("packages are vendored into .ntsc/<name> and imported by name:")
    say("  use \"json\"")
}
