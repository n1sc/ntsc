use "lockfile" as lockfile
use "registry" as registry
use "semver" as semver
use "source" as source
use "toml_utils" as toml_utils

use arrays
use collections
use paths
use strings

/// Resolve every direct and transitive dependency into
/// `name\tversion\trepo\tcheckout` records.
///
/// A version recorded in the lockfile is reused while it still satisfies the
/// requirement, so a plain `install` reproduces the previous resolution and
/// `update` (which passes an empty lockfile) picks the newest release.
fun resolve(view string manifest_json, view string lock_json) -> result[array[string], string] {
    var plan = arrays.new()
    var chosen = collections.set_new()
    var queue = arrays.new()

    var deps = toml_utils.get_dependencies(manifest_json)
    var names = toml_utils.dependency_names(deps)
    var count = arrays.length(names)
    for (var i = 0; i < count; i = i + 1) {
        var name = arrays.get(names, i)
        var spec = toml_utils.get_dependency(deps, name)
        if (strings.is_empty(spec)) {
            spec = "*"
        }
        arrays.push(queue, copy(name) + "\t" + copy(spec))
    }

    var cursor = 0
    while (cursor < arrays.length(queue)) {
        var entry = arrays.get(queue, cursor)
        cursor = cursor + 1
        var fields = strings.split_array(entry, "\t")
        var name = arrays.get(fields, 0)
        var spec = "*"
        if (arrays.length(fields) >= 2) {
            spec = arrays.get(fields, 1)
        }

        if (collections.set_has(chosen, name)) {
            var pinned = planned_version(plan, name)
            if (!semver.satisfies(pinned, spec)) {
                var message = "dependency conflict: '" + copy(name) + "' is pinned to " + copy(pinned)
                message = message + ", which does not satisfy '" + copy(spec) + "'"
                return Err(message)
            }
            continue
        }

        var version = lockfile.locked_version(lock_json, name)
        if (strings.is_empty(version) || !semver.satisfies(version, spec)) {
            version = registry.find_best_version(name, spec)?
        }
        var repo = registry.get_repo(name)?
        var checkout = source.checkout(name, version, repo)?

        arrays.push(plan, copy(name) + "\t" + copy(version) + "\t" + copy(repo) + "\t" + copy(checkout))
        collections.set_add(chosen, name)

        var sub_deps = sub_dependencies(checkout)
        var sub_names = toml_utils.dependency_names(sub_deps)
        var sub_count = arrays.length(sub_names)
        for (var j = 0; j < sub_count; j = j + 1) {
            var sub_name = arrays.get(sub_names, j)
            var sub_spec = toml_utils.get_dependency(sub_deps, sub_name)
            if (strings.is_empty(sub_spec)) {
                sub_spec = "*"
            }
            arrays.push(queue, copy(sub_name) + "\t" + copy(sub_spec))
        }
    }

    return Ok(plan)
}

/// The dependencies declared by an already-checked-out package.
fun sub_dependencies(view string checkout) -> string {
    var manifest = paths.join(checkout, "neutron.toml")
    var result[string, string] parsed = toml_utils.read_toml(manifest)
    match (parsed) {
        case Ok(json) => return toml_utils.get_dependencies(json)
        case Err(_) => return "{}"
    }
}

fun planned_version(view array[string] plan, view string name) -> string {
    var count = arrays.length(plan)
    for (var i = 0; i < count; i = i + 1) {
        var fields = strings.split_array(arrays.get(plan, i), "\t")
        if (arrays.get(fields, 0) == name) {
            return arrays.get(fields, 1)
        }
    }
    return ""
}
