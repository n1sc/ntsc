use "lockfile" as lockfile
use "registry" as registry
use "resolve" as resolver
use "source" as source
use "toml_utils" as toml_utils

use arrays
use crypto
use fmt
use paths
use strings
use sys
use term

fun style(view string code, view string text) -> string {
    if (!term.is_tty()) {
        return copy(text)
    }
    var escape = strings.from_char_code(27)
    return escape + "[" + copy(code) + "m" + copy(text) + escape + "[0m"
}

fun cyan(view string text) -> string {
    return style("36", text)
}

fun dim(view string text) -> string {
    return style("2", text)
}

fun green(view string text) -> string {
    return style("32", text)
}

fun bold(view string text) -> string {
    return style("1", text)
}

fun symbol(view string terminal_symbol, view string plain_symbol) -> string {
    if (term.is_tty()) {
        return copy(terminal_symbol)
    }
    return copy(plain_symbol)
}

fun package_word(int count) -> string {
    if (count == 1) {
        return "package"
    }
    return "packages"
}

fun install_header(int count) {
    say("")
    say("  " + cyan(symbol("◆", ">")) + " " + bold("neutron modules"))
    if (count == 1) {
        say("  " + dim("resolving 1 dependency"))
    } else {
        say("  " + dim("resolving " + fmt.i64_to_str(count) + " dependencies"))
    }
}

fun install_success(int count) {
    var total = fmt.i64_to_str(count)
    say("  " + green(symbol("✓", "ok")) + " " + bold("installed " + total + " " + package_word(count)))
    say("  " + dim("linked into .ntsc/"))
    say("")
}

/// Install the manifest's dependencies, reusing the lockfile where it still
/// satisfies the declared requirements.
fun install(view string project_dir) -> result[bool, string] {
    var manifest = read_manifest(project_dir)?
    var lock_json = lockfile.read_lockfile(lock_path(project_dir))?
    return apply(project_dir, manifest, lock_json)
}

/// Re-resolve from scratch and pick the newest satisfying version.
fun update(view string project_dir) -> result[bool, string] {
    var manifest = read_manifest(project_dir)?
    return apply(project_dir, manifest, "{}")
}

/// Add `name` (optionally `name@requirement`) to the manifest and install it.
fun add(view string project_dir, view string request) -> result[bool, string] {
    var name = copy(request)
    var requirement = "*"
    var at = strings.index_of(request, "@", 0)
    if (at > 0) {
        name = strings.substring(request, 0, at)
        requirement = strings.substring(request, at + 1, strings.length(request))
    }
    if (!source.is_safe_name(name)) {
        return Err("install: invalid package name '" + copy(name) + "'")
    }

    var version = registry.find_best_version(name, requirement)?
    var pin = "^" + copy(version)
    if (requirement != "*") {
        pin = copy(requirement)
    }

    var toml_path = paths.join(project_dir, "neutron.toml")
    toml_utils.set_dependency(toml_path, name, pin)?
    say("  " + cyan(symbol("↳", ">>")) + " " + dim("manifest updated") + "  " + copy(name) + " = \"" + pin + "\"")
    return install(project_dir)
}

fun remove(view string project_dir, view string name) -> result[bool, string] {
    var toml_path = paths.join(project_dir, "neutron.toml")
    toml_utils.remove_dependency(toml_path, name)?
    say("  " + cyan(symbol("↳", ">>")) + " " + dim("manifest updated") + "  removed " + copy(name))
    return install(project_dir)
}

fun list_installed(view string project_dir) -> result[bool, string] {
    var lock_json = lockfile.read_lockfile(lock_path(project_dir))?
    var names = lockfile.list_packages(lock_json)
    var count = arrays.length(names)
    if (count == 0) {
        say("no packages installed")
        return Ok(true)
    }
    for (var i = 0; i < count; i = i + 1) {
        var name = arrays.get(names, i)
        say("  " + copy(name) + " " + lockfile.locked_version(lock_json, name))
    }
    say(fmt.i64_to_str(count) + " package(s) installed")
    return Ok(true)
}

fun read_manifest(view string project_dir) -> result[string, string] {
    var toml_path = paths.join(project_dir, "neutron.toml")
    if (!sys.exists(toml_path)) {
        return Err("no neutron.toml in " + copy(project_dir))
    }
    return toml_utils.read_toml(toml_path)
}

fun lock_path(view string project_dir) -> string {
    return paths.join(project_dir, "neutron.lock")
}

fun apply(view string project_dir, view string manifest, view string lock_json) -> result[bool, string] {
    var plan = resolver.resolve(manifest, lock_json)?
    var vendor_root = paths.join(project_dir, ".ntsc")
    var entries = arrays.new()
    var count = arrays.length(plan)

    if (count == 0) {
        install_header(0)
        say("  " + green(symbol("✓", "ok")) + " " + bold("manifest already in sync"))
        say("")
        prune_vendor(vendor_root, plan)
        lockfile.write_lockfile(lock_path(project_dir), entries)?
        return Ok(true)
    }

    install_header(count)

    try {
        sys.mkdir(vendor_root)
    } catch (err) {
        return Err("install: cannot create " + copy(vendor_root) + ": " + err)
    }
    write_gitignore(vendor_root)

    for (var i = 0; i < count; i = i + 1) {
        var fields = strings.split_array(arrays.get(plan, i), "\t")
        var name = arrays.get(fields, 0)
        var version = arrays.get(fields, 1)
        var repo = arrays.get(fields, 2)
        var checkout = arrays.get(fields, 3)
        var target = paths.join(vendor_root, name)

        sys.rm_all(target)
        if (!sys.cp_all(checkout, target)) {
            return Err("install: cannot copy '" + copy(name) + "' into " + copy(vendor_root))
        }
        sys.rm_all(paths.join(target, ".git"))

        var integrity = compute_integrity(target)
        var record = copy(name) + "\t" + copy(version) + "\t" + copy(repo) + "\t" + "sha256:" + integrity
        arrays.push(entries, record)
        say("  " + green(symbol("✓", "ok")) + " " + copy(name) + " " + dim("v" + copy(version)))
    }

    prune_vendor(vendor_root, plan)
    lockfile.write_lockfile(lock_path(project_dir), entries)?
    install_success(count)
    return Ok(true)
}

/// The vendored tree is reproducible from `neutron.lock`, so it stays out of
/// version control.
fun write_gitignore(view string vendor_root) {
    try {
        sys.write(paths.join(vendor_root, ".gitignore"), "*\n")
    } catch (_) {}
}

/// Remove vendored packages that the new resolution no longer contains.
fun prune_vendor(view string vendor_root, view array[string] plan) {
    if (!sys.exists(vendor_root)) {
        return
    }
    try {
        var listing = strings.split_array(sys.listdir(vendor_root), "\n")
        var count = arrays.length(listing)
        for (var i = 0; i < count; i = i + 1) {
            var name = arrays.get(listing, i)
            if (strings.is_empty(name) || strings.starts_with(name, ".")) {
                continue
            }
            if (!is_planned(plan, name)) {
                sys.rm_all(paths.join(vendor_root, name))
            }
        }
    } catch (_) {}
}

fun is_planned(view array[string] plan, view string name) -> bool {
    var count = arrays.length(plan)
    for (var i = 0; i < count; i = i + 1) {
        var fields = strings.split_array(arrays.get(plan, i), "\t")
        if (arrays.get(fields, 0) == name) {
            return true
        }
    }
    return false
}

/// A content hash of the vendored tree, recorded in the lockfile so a changed
/// checkout is visible.
fun compute_integrity(view string dir) -> string {
    var hash_input = ""
    var files = strings.split_array(sys.walk(dir), "\n")
    var count = arrays.length(files)
    for (var i = 0; i < count; i = i + 1) {
        var file = arrays.get(files, i)
        if (strings.is_empty(file) || strings.ends_with(file, "/")) {
            continue
        }
        try {
            hash_input = hash_input + copy(file) + sys.read(paths.join(dir, file))
        } catch (_) {}
    }
    return crypto.sha256(hash_input)
}
