use "text" as text

use sys
use toml
use json
use strings
use arrays

/// `{}` when the project has never been installed.
fun read_lockfile(view string path) -> result[string, string] {
    if (!sys.exists(path)) {
        return Ok("{}")
    }
    var content = ""
    try {
        content = sys.read(path)
    } catch (err) {
        return Err("cannot read " + copy(path) + ": " + err)
    }
    var parsed = ""
    try {
        parsed = toml.parse(content)
    } catch (err) {
        return Err("cannot parse " + copy(path) + ": " + err)
    }
    return Ok(parsed)
}

fun locked_version(view string lock_json, view string name) -> string {
    return table_value(lock_json, "packages", name)
}

fun locked_source(view string lock_json, view string name) -> string {
    return table_value(lock_json, "sources", name)
}

fun locked_integrity(view string lock_json, view string name) -> string {
    return table_value(lock_json, "integrity", name)
}

fun table_value(view string lock_json, view string table, view string name) -> string {
    if (lock_json == "{}") {
        return ""
    }
    var values = json.get(lock_json, table)
    if (values == "null") {
        return ""
    }
    var value = text.unquote(json.get(values, name))
    if (value == "null") {
        return ""
    }
    return value
}

/// Every locked package name, in the order the file lists them.
fun list_packages(view string lock_json) -> array[string] {
    var names = arrays.new()
    if (lock_json == "{}") {
        return names
    }
    var packages = json.get(lock_json, "packages")
    if (packages == "null") {
        return names
    }
    var keys = json.keys(packages)
    if (strings.is_empty(keys)) {
        return names
    }
    var parts = strings.split_array(keys, ",")
    var count = arrays.length(parts)
    for (var i = 0; i < count; i = i + 1) {
        var name = strings.trim(arrays.get(parts, i))
        if (!strings.is_empty(name)) {
            arrays.push(names, copy(name))
        }
    }
    return names
}

/// `entries` holds `name\tversion\tsource\tintegrity` records.
fun write_lockfile(view string path, view array[string] entries) -> result[bool, string] {
    var lines = arrays.new()
    arrays.push(lines, "# Generated by `ntsc pkg`; run `ntsc pkg install` to refresh it.")
    arrays.push(lines, "version = 1")
    var count = arrays.length(entries)
    if (count > 0) {
        arrays.push(lines, "")
        arrays.push(lines, "[packages]")
        for (var i = 0; i < count; i = i + 1) {
            var fields = strings.split_array(arrays.get(entries, i), "\t")
            arrays.push(lines, copy(arrays.get(fields, 0)) + " = \"" + copy(arrays.get(fields, 1)) + "\"")
        }
        arrays.push(lines, "")
        arrays.push(lines, "[sources]")
        for (var i = 0; i < count; i = i + 1) {
            var fields = strings.split_array(arrays.get(entries, i), "\t")
            arrays.push(lines, copy(arrays.get(fields, 0)) + " = \"" + quote(arrays.get(fields, 2)) + "\"")
        }
        arrays.push(lines, "")
        arrays.push(lines, "[integrity]")
        for (var i = 0; i < count; i = i + 1) {
            var fields = strings.split_array(arrays.get(entries, i), "\t")
            arrays.push(lines, copy(arrays.get(fields, 0)) + " = \"" + quote(arrays.get(fields, 3)) + "\"")
        }
    }
    var content = arrays.join(lines, "\n") + "\n"
    var written = false
    try {
        written = sys.write(path, content)
    } catch (err) {
        return Err("cannot write " + copy(path) + ": " + err)
    }
    return Ok(written)
}

fun quote(view string s) -> string {
    return strings.replace(s, "\"", "\\\"")
}
